{
  "appId": "com.warrior.scheduler",
  "appName": "Warrior Scheduler AI",
  "webDir": "www",
  "backgroundColor": "#0B0A08",
  "server": {
    "androidScheme": "https"
  },
  "android": {
    "backgroundColor": "#0B0A08",
    "allowMixedContent": false
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 800,
      "backgroundColor": "#0B0A08",
      "androidScaleType": "CENTER_CROP",
      "showSpinner": false
    },
    "LocalNotifications": {
      "smallIcon": "ic_stat_icon",
      "iconColor": "#C9A227"
    }
  }
}
